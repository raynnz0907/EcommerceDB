# ─────────────────────────────────────────────
#  DBMS E-Commerce Project — Root .gitignore
# ─────────────────────────────────────────────

# ════════════════════════════
#  🔐 SENSITIVE / SECRET FILES
# ════════════════════════════

# Environment variables (DB credentials, API keys, secrets)
.env
.env.*
!.env.example        # allow a safe template to be committed

# Database config & dumps
*.sql.bak
*.dump
*.pgdump
*.db
*.sqlite
*.sqlite3

# Seed files with real data (remove this line if you want to track seed_data.sql)
backend/seed_data.sql

# SSL / TLS certificates & private keys
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# JWT secrets, API keys stored in files
secrets.json
credentials.json
serviceAccountKey.json

# ════════════════════════════
#  📦 DEPENDENCIES
# ════════════════════════════

node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# ════════════════════════════
#  🏗️  BUILD OUTPUT
# ════════════════════════════

frontend/dist/
frontend/dist-ssr/
frontend/build/
backend/dist/

# ════════════════════════════
#  📋 LOGS
# ════════════════════════════

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ════════════════════════════
#  💻 OS & EDITOR FILES
# ════════════════════════════

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code (allow shared settings via extensions.json only)
.vscode/*
!.vscode/extensions.json
.history/

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Vim / Emacs swap files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
\#*\#

# ════════════════════════════
#  ⚙️  RUNTIME & CACHE
# ════════════════════════════

.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.local

# Coverage reports
coverage/
*.lcov
.nyc_output/

# Testing
test-results/
playwright-report/
